{
  "input": {
    "path": "data/test_points.geojson",
    "format": "geojson",
    "source_crs": "EPSG:4326"
  },
  "output": {
    "path": "output/test_3d.shp",
    "format": "shp",
    "target_crs": "EPSG:4326"
  },
  "geometry": {
    "z_source": {
      "value": 10.0
    }
  },
  "field_mappings": [
    {"target": "ID", "expression": "[id]"},
    {"target": "NAME", "expression": "[name]"}
  ]
}